# Identity / handle convention used when generating metadata records.
# Copy to .env and fill in. .env is gitignored.

# Handle convention (see layers-repo notes/handle-convention-for-new-datasets.md):
# records address each other as
#   at://<namespace>.<stem>.repo.<domain>/<collection>/<rkey>
# The handle resolves to a minted DID at publish time (bring-your-own-handle
# DNS flow), so nothing here hardcodes a DID.

# Dataset stem, by convention <dataset>.<lang-iso639-3>.
SUPERMEREO_STEM=supertelicity.eng

# Project domain the layers records publish under.
SUPERMEREO_DOMAIN=supermereo.io

# External URL or DOI for the ELM paper; the eprint record carries it and the
# corpus / expressions / fillings reference that record.
SUPERMEREO_EPRINT_URL=https://experimentsinlinguisticmeaning.org/

# Lexicon checkouts used by scripts/validate_metadata.mjs. These upstream
# schemas are not vendored in this repo, so validation needs a local copy of
# each; point these at wherever you cloned them. The layers lexicons must be
# the 0.9.0 release (branch lexicons-v0.9.0). Generation does not read these.
# Example: LAYERS_LEXICONS=/path/to/layers/lexicons
LAYERS_LEXICONS=
